# RepoHub backend configuration.
#
# Copy to `.env` (git-ignored) and fill in values: cp .env.sample .env
# Vapor loads `.env` and `.env.<environment>` from the working directory at startup.
# Never commit real values. Production values live in the hosting provider's
# secret store and GitHub Actions environments (see docs/configuration.md).
#
# Every variable read by the backend must be listed here; CI enforces this.

# --- Currently used ----------------------------------------------------------

# Log verbosity: trace, debug, info, notice, warning, error, critical
LOG_LEVEL=debug

# Git commit of the running build, reported by GET /health. Set by CI/CD.
BUILD_COMMIT=dev

# PostgreSQL connection (#30). Required. Without `sslmode` in the URL, TLS is
# required in production and disabled elsewhere; add `?sslmode=disable` for a
# private network that encrypts traffic itself.
DATABASE_URL=postgres://repohub:repohub@localhost:5432/repohub_dev

# Connections per event loop in the database pool (default 4).
DATABASE_MAX_CONNECTIONS=4

# Database for integration tests (read by `swift test`, not the server). Tests
# that need PostgreSQL are skipped when it's unset. Never point it at dev or prod:
# tests drop every table.
TEST_DATABASE_URL=postgres://repohub:repohub@localhost:5432/repohub_test

# --- Planned (uncomment when the linked issue lands) -------------------------

# Redis cache (#35)
# REDIS_URL=redis://localhost:6379

# GitHub OAuth app for device-flow sign-in (#49, #75)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Signing key for app session tokens (#49). Generate with: openssl rand -base64 32
# JWT_SIGNING_KEY=

# GitHub webhook secret for signature verification (#49, #77)
# GITHUB_WEBHOOK_SECRET=

# Error tracking (#51)
# SENTRY_DSN=

# Email alerts on unhandled errors (#52)
# EMAIL_API_KEY=
# ALERT_EMAIL_TO=
