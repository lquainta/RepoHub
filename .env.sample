# RepoHub backend configuration.
#
# Copy to `.env` (git-ignored) and fill in values: cp .env.sample .env
# Vapor loads `.env` and `.env.<environment>` from the working directory at startup.
# Never commit real values. Production values live in the hosting provider's
# secret store and GitHub Actions environments (see docs/configuration.md).
#
# Every variable read by the backend must be listed here; CI enforces this.

# --- Currently used ----------------------------------------------------------

# Log verbosity: trace, debug, info, notice, warning, error, critical.
# Default: notice in production, info elsewhere. Changes take effect on restart.
LOG_LEVEL=debug

# Log output: json (one object per line with timestamp, level, request_id) or
# text (human-readable). Default: json in production, text elsewhere.
LOG_FORMAT=text

# Git commit of the running build, reported by GET /health. Set by CI/CD.
BUILD_COMMIT=dev

# PostgreSQL connection (#30). Required. Without `sslmode` in the URL, TLS is
# required in production and disabled elsewhere; add `?sslmode=disable` for a
# private network that encrypts traffic itself.
DATABASE_URL=postgres://repohub:repohub@localhost:5432/repohub_dev

# Connections per event loop in the database pool (default 4).
DATABASE_MAX_CONNECTIONS=4

# --- Authentication and security (#49) ---------------------------------------
# Required in production. In development, missing keys are replaced with random
# ones until restart, and missing GitHub settings disable sign-in/webhooks.

# GitHub OAuth app client ID for device-flow sign-in. Public; no client secret
# is needed for the device flow.
GITHUB_CLIENT_ID=Ov23li4JZbF4b63nM3Eh

# HMAC key for access tokens. Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=

# AES-256-GCM key for GitHub tokens at rest; exactly 32 bytes.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Shared secret for GitHub webhook signatures. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Requests per minute per client IP, and per IP to /auth (defaults 120 and 30).
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=30

# Redis for the GitHub response cache (#35). Required in production; when
# unset elsewhere, an in-memory cache is used.
REDIS_URL=redis://localhost:6379

# Redis for integration tests (read by `swift test`). Tests use unique keys and
# never flush, so pointing it at the development Redis is safe.
TEST_REDIS_URL=redis://localhost:6379

# Database for integration tests (read by `swift test`, not the server). Tests
# that need PostgreSQL are skipped when it's unset. Never point it at dev or prod:
# tests drop every table.
TEST_DATABASE_URL=postgres://repohub:repohub@localhost:5432/repohub_test

# --- Planned (uncomment when the linked issue lands) -------------------------

# Error tracking (#51)
# SENTRY_DSN=

# Email alerts on unhandled errors (#52)
# EMAIL_API_KEY=
# ALERT_EMAIL_TO=
