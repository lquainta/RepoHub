#!/usr/bin/env bash
# Requires a Conventional Commits subject (see CONTRIBUTING.md), for example
#   feat(core): parse porcelain v2 status
# Merge, revert, fixup!, and squash! commits generated by git are allowed.
set -euo pipefail

subject=$(grep -v '^#' "$1" | head -n 1)
types='feat|fix|test|docs|ci|chore|refactor|perf|build'
scopes='app|core|backend|ci|docs|deps'
pattern="^(${types})(\\((${scopes})\\))?!?: [^ ].*"

if [[ "$subject" =~ $pattern ]] || [[ "$subject" =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]]; then
    if [ "${#subject}" -gt 100 ]; then
        echo "✗ Commit subject is ${#subject} characters; keep it under 100." >&2
        exit 1
    fi
    exit 0
fi

cat >&2 <<MESSAGE
✗ Commit message must follow Conventional Commits:

    <type>(<optional scope>): <description>

  types:  ${types//|/, }
  scopes: ${scopes//|/, }
  e.g.    feat(core): parse porcelain v2 status

Got: "$subject"
MESSAGE
exit 1
