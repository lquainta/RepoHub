{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "RepoHub",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "ci",
          "section": "CI/CD"
        },
        {
          "type": "build",
          "section": "Build"
        },
        {
          "type": "refactor",
          "section": "Refactoring",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Chores",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "generic",
          "path": "App/project.yml"
        },
        {
          "type": "generic",
          "path": "Packages/RepoHubCore/Sources/RepoHubCore/RepoHubCore.swift"
        }
      ],
      "pull-request-title-pattern": "chore: release ${version}",
      "pull-request-header": "Merging this PR tags the release and publishes it on GitHub Releases."
    }
  }
}
